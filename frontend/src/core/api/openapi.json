{
  "openapi": "3.0.3",
  "info": {
    "title": "Игры через MCP",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "core"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "slug",
                    "version"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "slug": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "summary": "Пачка событий аудита с фронта",
        "tags": [
          "stats"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "v",
                  "s",
                  "e"
                ],
                "properties": {
                  "v": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "s": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "vis": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "r": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "e": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "t"
                      ],
                      "properties": {
                        "t": {
                          "type": "string",
                          "pattern": "^[a-z_]{1,32}$",
                          "description": "Тип события: page_view, click, js_error, …"
                        },
                        "n": {
                          "type": "string",
                          "maxLength": 300
                        },
                        "p": {
                          "type": "string",
                          "maxLength": 300
                        },
                        "ts": {
                          "type": "number"
                        },
                        "d": {
                          "type": "object",
                          "additionalProperties": {}
                        }
                      }
                    },
                    "maxItems": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Счётчики для подвала",
        "tags": [
          "stats"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "visits",
                    "users"
                  ],
                  "properties": {
                    "visits": {
                      "type": "integer"
                    },
                    "users": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/spaces": {
      "post": {
        "summary": "Новое пространство (токен для MCP)",
        "tags": [
          "games"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token"
                  ],
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/space": {
      "delete": {
        "summary": "Удалить пространство со всеми играми",
        "tags": [
          "games"
        ],
        "responses": {
          "204": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/games": {
      "get": {
        "summary": "Мои игры",
        "tags": [
          "games"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "games",
                    "limits"
                  ],
                  "properties": {
                    "games": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "title",
                          "size",
                          "version",
                          "complete",
                          "parts",
                          "createdAt",
                          "updatedAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "size": {
                            "type": "integer"
                          },
                          "version": {
                            "type": "integer"
                          },
                          "complete": {
                            "type": "boolean"
                          },
                          "parts": {
                            "type": "integer"
                          },
                          "createdAt": {
                            "type": "integer"
                          },
                          "updatedAt": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "limits": {
                      "type": "object",
                      "required": [
                        "games",
                        "gameBytes"
                      ],
                      "properties": {
                        "games": {
                          "type": "integer"
                        },
                        "gameBytes": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/games/{id}": {
      "get": {
        "summary": "Игра целиком",
        "tags": [
          "games"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8}$"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "size",
                    "version",
                    "complete",
                    "parts",
                    "createdAt",
                    "updatedAt",
                    "html"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "version": {
                      "type": "integer"
                    },
                    "complete": {
                      "type": "boolean"
                    },
                    "parts": {
                      "type": "integer"
                    },
                    "createdAt": {
                      "type": "integer"
                    },
                    "updatedAt": {
                      "type": "integer"
                    },
                    "html": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Удалить игру",
        "tags": [
          "games"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8}$"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/games/{id}/report": {
      "post": {
        "summary": "Вкладка запустила игру; ошибки JS, если были",
        "tags": [
          "games"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version",
                  "errors"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "maxItems": 20
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8}$"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "Default Response"
          }
        }
      }
    }
  }
}
